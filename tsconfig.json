{
  "compilerOptions": {
    "target": "es2016",
    "module": "CommonJS",
    "esModuleInterop": true,
    "outDir": "./build",
    "rootDir": "./source",
    "strict": true,
    "skipLibCheck": true, // 라이브러리 간의 미세한 타입 충돌 무시 (빌드 속도 향상)
    "typeRoots": ["./node_modules/@types", "./source/types"]
  },
  "ts-node": {
    "files": true
  },
  "include": ["source/**/*", "source/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}